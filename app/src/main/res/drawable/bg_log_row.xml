<?xml version="1.0" encoding="utf-8"?>
<!-- Log rows sit inside a card, so their focus state is a quieter highlight
     than the full glow used for top-level boxes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="140">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/log_row_focused" />
            <stroke android:width="2dp" android:color="@color/accent_border_soft" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
