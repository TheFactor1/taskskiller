<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/activeBackendText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Shizuku first: it is the recommended method and can now be set up
             from the TV itself, so it gets the prominent buttons. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shizuku_header"
            style="@style/SectionHeader" />

        <TextView
            android:id="@+id/shizukuStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/autoSetupButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_setup" />

            <Button
                android:id="@+id/getShizukuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/get_shizuku" />

            <Button
                android:id="@+id/shizukuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/grant_shizuku" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_setup_desc"
            style="@style/Body" />

        <TextView
            android:id="@+id/autoSetupResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:visibility="gone"
            style="@style/Body" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoStartShizukuSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auto_start_shizuku"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kill_backends_header"
            style="@style/SectionHeader" />

        <TextView
            android:id="@+id/backendListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permissions_header"
            style="@style/SectionHeader" />

        <TextView
            android:id="@+id/exactAlarmText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body" />

        <Button
            android:id="@+id/exactAlarmButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/fix" />

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Body" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/fix" />

        <TextView
            android:id="@+id/overlayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Body" />

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/fix" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adb_header"
            style="@style/SectionHeader" />

        <TextView
            android:id="@+id/adbText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/adb_body"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            style="@style/Body" />
    </LinearLayout>
</ScrollView>
