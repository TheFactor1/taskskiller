<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="32dp"
    android:paddingEnd="48dp">

    <TextView
        style="@style/ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/pick_app_title" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/systemAppsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/show_system_apps" />

    <!-- Clipped to its own bounds (outline clip in AppPickerActivity) so rows
         cannot scroll over the switch above. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="40dp"
        android:overScrollMode="never"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        android:requiresFadingEdge="vertical" />
</LinearLayout>
