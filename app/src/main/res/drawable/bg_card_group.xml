<?xml version="1.0" encoding="utf-8"?>
<!-- Card around focusable controls (with addStatesFromChildren): the border
     brightens while one of its controls has focus. The control itself glows. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="160"
    android:exitFadeDuration="160">

    <item android:state_focused="true">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <gradient
                    android:angle="270"
                    android:startColor="@color/surface_top"
                    android:endColor="@color/surface_bottom" />
                <stroke android:width="1dp" android:color="@color/accent_border_soft" />
            </shape>
        </inset>
    </item>

    <item android:drawable="@drawable/bg_card" />
</selector>
