<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TasksKiller" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <!-- The gradient lives on the window so every screen shares it and the
             layouts themselves stay transparent. -->
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.TasksKiller.Button</item>
        <item name="switchStyle">@style/Widget.TasksKiller.SwitchRow</item>
        <item name="seekBarStyle">@style/Widget.TasksKiller.SeekBar</item>
        <item name="android:seekBarStyle">@style/Widget.TasksKiller.SeekBar</item>
    </style>

    <!-- Buttons: pills with a glow ring when focused. The ring is drawn inside
         the view's bounds, so every background reserves a 4dp margin for it
         and the button body sits inset by that much. They do not grow on
         focus: scaling pushed a selected pill past the line its neighbours
         and the card text sit on, so only the ring marks the selection. -->
    <style name="Widget.TasksKiller.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.TasksKiller.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
    </style>

    <style name="Widget.TasksKiller.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
    </style>

    <style name="Widget.TasksKiller.Button.Small">
        <item name="android:minHeight">46dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- Switches are whole rows, so the glow wraps the label too. Full-width
         rows and cards glow but do not grow: scaling pushed them out of line
         with their neighbours and into the card margin. -->
    <style name="Widget.TasksKiller.SwitchRow" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:background">@drawable/focusable_item</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="switchPadding">16dp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.TasksKiller.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:background">@drawable/focusable_item</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:progressTint">@color/accent</item>
        <item name="android:progressBackgroundTint">@color/hairline_strong</item>
        <item name="android:thumbTint">@color/accent_bright</item>
        <item name="android:splitTrack">false</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Type -->
    <style name="ScreenTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SectionHeader">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Mono" parent="Body">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Cards. The 24dp padding includes the 4dp reserved for the focus ring.
         Text directly inside a card that also holds controls takes a further
         4dp start/end margin, so it lines up with the pills and rows, whose
         bodies sit 4dp inside their own bounds. -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">22dp</item>
        <item name="android:clipChildren">false</item>
    </style>

    <!-- A card whose controls take focus: its border brightens while any of
         them is focused, so the box being worked in stays obvious. -->
    <style name="Card.Group">
        <item name="android:background">@drawable/bg_card_group</item>
        <item name="android:addStatesFromChildren">true</item>
    </style>

    <!-- A card with nothing to press: the card itself takes focus, so the
         D-pad can stop on it instead of jumping past. -->
    <style name="Card.Focusable">
        <item name="android:background">@drawable/focusable_item</item>
        <item name="android:focusable">true</item>
        <!-- Text only, so it takes the extra 4dp itself to line up with the
             text of the neighbouring cards that hold controls. -->
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
    </style>
</resources>
