<?xml version="1.0" encoding="utf-8"?>
<com.thefactor1.taskskiller.ui.FocusScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadingEdgeLength="48dp"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="48dp">

        <TextView
            style="@style/ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/setup_title" />

        <TextView
            android:id="@+id/activeBackendText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent_bright"
            android:textSize="16sp" />

        <!-- Shizuku first: it is the recommended method and can be set up from
             the TV itself, so it gets the prominent buttons. -->
        <LinearLayout
            style="@style/Card.Group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/shizuku_header" />

            <TextView
                android:id="@+id/shizukuStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/autoSetupButton"
                    style="@style/Widget.TasksKiller.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_setup" />

                <Button
                    android:id="@+id/getShizukuButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/get_shizuku" />

            </LinearLayout>

            <!-- Own line: with three buttons in one row the last one ran past the
                 card's edge on larger system font sizes. Only shown when needed. -->
            <Button
                android:id="@+id/shizukuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/grant_shizuku" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="4dp"
                android:text="@string/auto_setup_desc" />

            <TextView
                android:id="@+id/autoSetupResultText"
                style="@style/Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_inset_box"
                android:padding="14dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoStartShizukuSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/auto_start_shizuku" />
        </LinearLayout>

        <!-- Nothing to press here, so the card itself takes focus. -->
        <LinearLayout
            style="@style/Card.Focusable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kill_backends_header" />

            <TextView
                android:id="@+id/backendListText"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Takes focus itself only when every permission is granted and its
             Fix buttons are hidden; see SetupActivity.refresh(). -->
        <LinearLayout
            android:id="@+id/permissionsCard"
            style="@style/Card.Group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/permissions_header" />

            <TextView
                android:id="@+id/exactAlarmText"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/exactAlarmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/fix" />

            <TextView
                android:id="@+id/batteryText"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/batteryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/fix" />

            <TextView
                android:id="@+id/overlayText"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/overlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/fix" />
        </LinearLayout>

        <!-- Reference text. Deliberately not selectable: a selectable TextView
             swallows the D-pad's up/down, which is what froze scrolling here. -->
        <LinearLayout
            style="@style/Card.Focusable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_header" />

            <TextView
                android:id="@+id/adbText"
                style="@style/Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_body" />
        </LinearLayout>
    </LinearLayout>
</com.thefactor1.taskskiller.ui.FocusScrollView>
