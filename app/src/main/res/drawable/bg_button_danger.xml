<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive action: muted red at rest, a red glow and solid fill on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="140">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/glow_bad_outer" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/glow_bad_inner" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/bad"
                        android:endColor="@color/bad_deep" />
                    <stroke android:width="2dp" android:color="@android:color/white" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="@color/bad_deep" />
            </shape>
        </inset>
    </item>

    <item>
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="@color/bad_soft" />
                <stroke android:width="1dp" android:color="@color/bad_border" />
            </shape>
        </inset>
    </item>
</selector>
