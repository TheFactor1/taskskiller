<?xml version="1.0" encoding="utf-8"?>
<!-- Static card. Inset by the same 4dp as the focusable cards so edges line up. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="4dp">
    <shape android:shape="rectangle">
        <corners android:radius="16dp" />
        <gradient
            android:angle="270"
            android:startColor="@color/surface_top"
            android:endColor="@color/surface_bottom" />
        <stroke android:width="1dp" android:color="@color/hairline" />
    </shape>
</inset>
