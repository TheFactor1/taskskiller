<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action: a glassy pill that lights up with the accent glow on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="140">

    <item android:state_enabled="false">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="@color/surface_glass" />
            </shape>
        </inset>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/glow_outer" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/glow_inner" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/surface_focused_top"
                        android:endColor="@color/surface_focused_bottom" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="@color/surface_focused" />
            </shape>
        </inset>
    </item>

    <item>
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="@color/surface_glass" />
                <stroke android:width="1dp" android:color="@color/hairline_strong" />
            </shape>
        </inset>
    </item>
</selector>
